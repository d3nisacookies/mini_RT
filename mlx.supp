{
   mlx_xopen
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libX11*
}
{
   mlx_xext
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libXext*
}
{
   mlx_xcb
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libxcb*
}
{
   mlx_init_leak
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:mlx_init
}
{
   mlx_window_leak
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:mlx_new_window
}

{
   mlx_writev_uninit
   Memcheck:Param
   writev(vector[0])
   fun:writev
   ...
   obj:*/libxcb*
   ...
   obj:*/libX11*
   ...
   fun:mlx_int_wait_first_expose
   fun:mlx_new_window
}